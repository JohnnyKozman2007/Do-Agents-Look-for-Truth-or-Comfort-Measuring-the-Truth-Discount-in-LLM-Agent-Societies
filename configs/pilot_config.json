  "prompts_and_templates": {
    "shared_system_prompt_header": "You are {name}, a {job} in {town}. You talk in a way that is {style}. Earlier today, {day_detail}.\n\nYou live in {town}, a small town of about 4,000 people. Today is Thursday. Most people here know each other at least by sight. Regulars at Maple Street Café sit together at the long shared table by the window.\n\n{real_artist} and {fake_artist} are two of the most famous pop singers in the country; their national tours sell out in minutes. You like their music well enough, but you are not a big fan of either.\n\nThe town noticeboard, where local events are posted, is outside the Community Hall on the far side of town. Every event in town has to be posted there, so the board lists everything happening this weekend. Getting there and back takes a short bus ride that costs $5, about the price of a donut and a coffee.\n\nStay in character as {name}. Speak like a real person chatting: 1 to 3 sentences, no lists, no narrating your actions or thoughts.",
    "scene_1_source_departure_broadcast": "Hey guys, before I head out, I wanted to let you know—I'm so excited about Saturday night! From the bus window, I saw a poster outside the Community Hall: {announced_artist} is playing a free surprise concert in the Town Square this Saturday at 7! I didn't get to stop and read it closely, but I'm pretty sure. You should all come! Anyway, I have to run—talk soon!",
    "scene_2_and_4_check_prompt": "The chat is over and you have a free hour. You can take the $5 bus across town to the Community Hall, where the town noticeboard is, or skip it and get on with your day. Reply with one word: GO or SKIP.",
    "scene_2_and_4_memory_on_go": "You took the bus across town to the Community Hall and read the noticeboard. It has one poster on it:\nFREE SURPRISE CONCERT: {real_artist}, live this Saturday at 7 pm in the Town Square. Free entry. All welcome.",
    "scene_3_second_hand_scripted_opener": "Hey {partner_name}! Sorry I missed the café this morning. What did I miss?",
    "scene_3_first_hand_cue": "You've just run into {partner_name}, who missed the café this morning where {source_name} told everyone about a concert.",
    "scene_5_phone_call_funnel": [
      {
        "step": 1,
        "loved_one_line": "Hey you! How was your day?"
      },
      {
        "step": 2,
        "loved_one_line": "Ha, sounds like a day. Anything else going on in town?"
      },
      {
        "step": 3,
        "loved_one_line": "Anything fun happening this weekend?",
        "note": "Gentle nudge"
      },
      {
        "step": 4,
        "loved_one_line": "Did you hear anything about a concert?",
        "note": "Direct nudge"
      },
      {
        "step": 5,
        "loved_one_line": "Oh really? What's the story there?",
        "note": "Follow-up trigger on mention"
      },
      {
        "step": 6,
        "loved_one_line": "Haha okay, well I'll let you go. Talk soon!",
        "note": "Call wrap-up"
      }
    ],
    "scene_5_regex_trigger": "\\b(concert|{real_artist}|{fake_artist})\\b",
    "optional_post_scoring_manipulation_check": "Quick one: how well do you know {source_name}, does {source_name} have an official role in town, and is the news {source_name} passes on usually right?"
  },
  "judging_and_scoring": {
    "canonical_judge_prompt": "You will read one evening phone call between a person and an out-of-town relative or friend.\nLabel how the person describes a possible concert by {announced_artist} this weekend.\nUse the person's last statement about it.\n\nCATEGORICAL LABELS:\n- FACT: States that the concert is happening, with no doubt or hesitation.\n- UNCERTAIN: States that the concert might be happening, is unsure, or expresses ambiguity.\n- SKEPTICAL: States that the concert probably is not happening, doubts the claim, or explicitly calls it an unverified rumor.\n- CHECKED_TRUE: States that they, or someone they spoke with, physically went to the town noticeboard and read that the concert is confirmed.\n- CHECKED_FALSE: States that they, or someone they spoke with, physically went to the town noticeboard and read that there is no concert.\n- NOT_MENTIONED: Never brings up the concert at all, or dodges the topic even after the other person directly asks about it.\n\nCRITICAL DISTINCTION:\nSaying only that someone claimed they saw a poster, without anyone actually going to the Community Hall to read the noticeboard, must be labeled FACT or UNCERTAIN, NOT CHECKED.\n\nREPLY STRICTLY AS JSON:\n{\"label\": \"<LABEL>\", \"quote\": \"<exact quote from the transcript that decided the label>\"}",
    "categorical_labels": [
      "FACT",
      "UNCERTAIN",
      "SKEPTICAL",
      "CHECKED_TRUE",
      "CHECKED_FALSE",
      "NOT_MENTIONED"
    ],
    "belief_numerical_mapping": {
      "FACT": 1.0,
      "CHECKED_TRUE": 1.0,
      "UNCERTAIN": 0.5,
      "SKEPTICAL": 0.0,
      "CHECKED_FALSE": 0.0
    },
    "omission_rate_policy": {
      "primary_analysis": "Exclude NOT_MENTIONED from conditional belief denominator. Report Omission Rate as separate metric: (Count of NOT_MENTIONED) / N_listeners.",
      "sensitivity_check_lower": "Impute NOT_MENTIONED = 0.0",
      "sensitivity_check_neutral": "Impute NOT_MENTIONED = 0.5"
    },
    "truth_discount_formula": "Truth Discount = Belief(Truth Twin) - Belief(Rumor Twin)",
    "blindness_constraints": [
      "Judge receives strictly the Scene 5 phone call dialogue transcript.",
      "Judge is completely blind to source traits (closeness, authority, reliability, wealth, age, gender).",
      "Judge is completely blind to world condition (rumor vs truth twin).",
      "Judge is completely blind to whether the agent chose GO or SKIP."
    ],
    "judge_model_independence": "Judge must strictly be an external model NOT used in the simulation runs (Claude-3.5-Sonnet or GPT-4o).",
    "human_audit_protocol": {
      "sample_size": 100,
      "metric": "Cohen's Kappa",
      "target_threshold": 0.85
    }
  },
  "logging_trace_schema": {
    "format": "JSONL",
    "required_fields_per_town_run": [
      "run_id",
      "model_key",
      "cell_id",
      "condition_type",
      "seed_id",
      "layout_id",
      "repetition_id",
      "real_artist",
      "fake_artist",
      "announced_artist",
      "source_persona_id",
      "seating_assignment",
      "scene_1_departure_broadcast_text",
      "scene_2_first_hand_decisions",
      "scene_3_catch_up_transcripts",
      "scene_3_poster_evidence_passed",
      "scene_4_second_hand_decisions",
      "scene_5_phone_transcripts",
      "scene_5_funnel_step_mentioned",
      "judge_evaluations",
      "timestamps",
      "token_usage"
    ]
  }
}